# Lib-local config — shared rules live in config/phpstan.neon (reusable by consumers)
# Extensions (symfony, doctrine, phpunit) are auto-loaded via phpstan/extension-installer
includes:
    - config/phpstan.neon

parameters:
    paths:
        - src

    tmpDir: var/cache/phpstan

    ignoreErrors:
        # Library traits are consumed by downstream projects, never internally
        - identifier: trait.unused
