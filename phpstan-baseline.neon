parameters:
	ignoreErrors:
		-
			message: '#^Access to an undefined property UnitEnum\:\:\$value\.$#'
			identifier: property.notFound
			count: 1
			path: src/Behat/Component/EntityManagerContext.php

		-
			message: '#^Call to function is_callable\(\) with array\{\$this\(Barlito\\Utils\\Behat\\Component\\EntityManagerContext\), ''assertEquals''\} will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Behat/Component/EntityManagerContext.php

		-
			message: '#^Method Barlito\\Utils\\Behat\\Component\\EntityManagerContext\:\:__construct\(\) overrides @final method PHPUnit\\Framework\\TestCase\:\:__construct\(\)\.$#'
			identifier: method.parentMethodFinalByPhpDoc
			count: 1
			path: src/Behat/Component/EntityManagerContext.php

		-
			message: '#^Method Barlito\\Utils\\Behat\\Component\\EntityManagerContext\:\:getAsString\(\) has parameter \$input with no type specified\.$#'
			identifier: missingType.parameter
			count: 1
			path: src/Behat/Component/EntityManagerContext.php

		-
			message: '#^Method Barlito\\Utils\\Behat\\Component\\EntityManagerContext\:\:getRepository\(\) return type with generic interface Doctrine\\Persistence\\ObjectRepository does not specify its types\: T$#'
			identifier: missingType.generics
			count: 1
			path: src/Behat/Component/EntityManagerContext.php

		-
			message: '#^Method Barlito\\Utils\\Behat\\Component\\EntityManagerContext\:\:getValueAtPath\(\) has parameter \$entity with no type specified\.$#'
			identifier: missingType.parameter
			count: 1
			path: src/Behat/Component/EntityManagerContext.php

		-
			message: '#^Method Barlito\\Utils\\Behat\\Component\\EntityManagerContext\:\:iCreateAEntityWithData\(\) has parameter \$entityClass with no type specified\.$#'
			identifier: missingType.parameter
			count: 1
			path: src/Behat/Component/EntityManagerContext.php

		-
			message: '#^Method Barlito\\Utils\\Behat\\Component\\EntityManagerContext\:\:parseFindByQueryString\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Behat/Component/EntityManagerContext.php

		-
			message: '#^Method PHPUnit\\Framework\\TestCase\:\:__construct\(\) invoked with 0 parameters, 1 required\.$#'
			identifier: arguments.count
			count: 1
			path: src/Behat/Component/EntityManagerContext.php

		-
			message: '#^Parameter \#1 \$className of method Doctrine\\ORM\\EntityManagerInterface\:\:getRepository\(\) expects class\-string\<object\>, string given\.$#'
			identifier: argument.type
			count: 1
			path: src/Behat/Component/EntityManagerContext.php

		-
			message: '#^Parameter \#1 \$entity of method Barlito\\Utils\\Behat\\Component\\EntityManagerContext\:\:valueShouldMatch\(\) expects object, object\|null given\.$#'
			identifier: argument.type
			count: 1
			path: src/Behat/Component/EntityManagerContext.php

		-
			message: '#^Parameter \#1 \$haystack of function str_contains expects string, int\|string given\.$#'
			identifier: argument.type
			count: 1
			path: src/Behat/Component/EntityManagerContext.php

		-
			message: '#^Parameter \#2 \$string of function explode expects string, int\|string given\.$#'
			identifier: argument.type
			count: 1
			path: src/Behat/Component/EntityManagerContext.php

		-
			message: '#^Unable to resolve the template type T in call to method Doctrine\\ORM\\EntityManagerInterface\:\:getRepository\(\)$#'
			identifier: argument.templateType
			count: 1
			path: src/Behat/Component/EntityManagerContext.php

		-
			message: '#^Method Barlito\\Utils\\Behat\\Component\\LoggerContext\:\:__construct\(\) overrides @final method Symfony\\Bundle\\FrameworkBundle\\Test\\KernelTestCase\:\:__construct\(\)\.$#'
			identifier: method.parentMethodFinalByPhpDoc
			count: 1
			path: src/Behat/Component/LoggerContext.php

		-
			message: '#^Attribute class JetBrains\\PhpStorm\\ArrayShape does not exist\.$#'
			identifier: attribute.notFound
			count: 1
			path: src/Behat/Mock/LoggerMock.php

		-
			message: '#^Method Barlito\\Utils\\Behat\\Mock\\LoggerMock\:\:addLoggedMessage\(\) has parameter \$context with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Behat/Mock/LoggerMock.php

		-
			message: '#^Method Barlito\\Utils\\Behat\\Mock\\LoggerMock\:\:containsLoggedMessage\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Behat/Mock/LoggerMock.php

		-
